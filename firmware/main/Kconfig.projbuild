menu "Pati"

    comment "Bu degerler sdkconfig.defaults.local dosyasina yazilir."
    comment "O dosya .gitignore'da — sifreler ve anahtar depoya GIRMEZ."

    # -----------------------------------------------------------------------
    # 🔴 PATI_WIFI_SSID ve PATI_WIFI_PASS KALDIRILDI — geri eklemeyin.
    # -----------------------------------------------------------------------
    #
    # Asama 2'de wifi bilgisi firmware'e gomuluyordu ve o asamada
    # dogruydu: tek amac gecikme olcmekti.
    #
    # Captive portal gelince wifi NVS'e tasindi (pati_ag.cpp) ama bu iki
    # ayar burada unutuldu. Hicbir kaynak dosya okumuyordu; yalnizca
    # uretilen sdkconfig.h'de goruunuyorlardi. Yani doldurulabilen,
    # derlemeye giren, ama HICBIR SEY YAPMAYAN iki ayardilar.
    #
    # Olu ayar olmayan ayardan kotudur: birileri doldurur, kart yine
    # baglanmaz ve sebebi dolduruIan yerde aranir.

    # -----------------------------------------------------------------------
    # 🔴 PATI_GEMINI_API_KEY BURADAN KALDIRILDI — geri EKLEMEYIN.
    # -----------------------------------------------------------------------
    #
    # Anahtar artik cihazda, kendi NVS bolumunde duruyor ve panelden
    # giriliyor (pati_anahtar.cpp).
    #
    # Sebep: panelden guncelleme, `pati.bin`'in GitHub'a konmasini
    # gerektiriyor. Anahtar derlemede gomulu kalsaydi her surumle birlikte
    # herkese acilir, faturayi da anahtarin sahibi oderdi.
    #
    # Kconfig girdisi silindi ki kimse "sadece kendi kartim icin"
    # doldurup yayimlamasin. Ayar orada dursaydi bunun bir gun olmasi
    # kesindi ve fark edilmesi imkansiz olurdu — bir dosyanin icinde
    # sessizce duran 39 karakter.

    config PATI_GUNCELLEME_ADRESI
        string "Guncelleme bilgisi (surum.json) adresi"
        default "https://github.com/General-dev-all/Pati-Robot/releases/latest/download/surum.json"
        help
            Pati "guncellemeleri kontrol et" dendiginde bu adresi cekiyor
            ve icindeki surumu kendi surumuyle karsilastiriyor.

            🔴 ADRES RELEASE'IN KENDISINI GOSTERIYOR, DEPOYU DEGIL.
            Onceden depodaki surum.json'a bakiyordu ve bunun sessiz bir
            kusuru vardi: push, dosyayi ANINDA yayina sokuyor ama
            pati.bin'i olusturmuyor. Aradaki surede panel "guncelleme
            var" der, anne basar ve indirme 404'e duserdi.

            `releases/latest/download/...` kisayolu bu bosluğu ortadan
            kaldiriyor: surum.json ile pati.bin AYNI Release'in icinde
            duruyor, yani manifest, tarif ettigi dosyadan once var
            olamiyor. Ikisini de GitHub Actions ayni adimda koyuyor.

            HTTPS OLMAK ZORUNDA. Duz HTTP'de araya giren biri robota
            istedigi kodu yukleyebilir. Firmware ayrica indirme adresinin
            de https oldugunu denetliyor.

    config PATI_MODEL
        string "Gemini Live model adi"
        default "gemini-3.1-flash-live-preview"
        help
            Asama 1'de "gemini-3.1-flash-live-preview" ile olculdu:
            medyan 1325 ms, kriter gecti. Degistirilirse olcum
            tekrarlanmali.

            ⚠️ 05.09.2026 — GERI ALINDI, 3.1'e donuldu.
            O gun model "cevap vermez" sanilip 2.5-native-audio'ya
            gecildi. Sonradan asil sebep cikti: Live API KOTASI doluydu
            ve sunucu bunu acikca soylemek yerine 1011 'Internal error'
            donuyordu (TESHIS.md). Yani model suclu degildi; ayni anda
            2.5 de cevap vermiyordu, kota acilinca ikisi de calisti.

            Asagidaki teshis notu yine de duruyor — belirti tarifi
            dogru ve bir daha yasanirsa ilk bakilacak yer orasi.
            Belirtisi tam bir "Pati bozuldu" taklidiydi ve gunun yarisi
            yanlis yerde arandi:

              - mikrofon calisiyordu
              - ses Gemini'ye ulasiyordu
              - Gemini cocugu DOGRU anlayip yaziya dokuyordu
                (log: "cocuk: Beni duyuyor musun?")
              - websocket acikti, HATA BILE VERMIYORDU
              - yalnizca cevap hic gelmiyordu

            Yani "sunucu sagir" degil, "sunucu susuyor". Cihaz tarafinda
            bakilacak hicbir sey yoktu.

            KANIT tahminle degil, cihazin disinda uretildi: ayni anahtarla
            bilgisayardan ham bir WebSocket acildi.

              gemini-3.1-flash-live-preview            -> setupComplete, sonra SESSIZLIK
              gemini-2.5-flash-native-audio-preview-*  -> setupComplete + cevap akiyor

            Anahtar, kota ve fatura da ayrica dogrulandi (REST ile
            gemini-3.1-flash-lite'a istek atildi, 200 ve gercek cevap).

            ⚠️ ONCE MODELI SINA. Bir gun Pati yine "duyuyor ama cevap
            vermiyor" haline duserse ilk yapilacak sey budur — cihaza
            dokunmadan, bilgisayardan ham WebSocket ile. Preview
            modeller haber vermeden davranis degistirebiliyor.

            ⚠️ Gecikme bu modelle YENIDEN OLCULMEDI.

    config PATI_SES
        string "Gemini sesi"
        default "Puck"
        help
            Asama 1'de panelden dinlenerek secildi (29.07.2026): Puck,
            calma hizi 1.30x ile birlikte Turkcesi "akici ve hizli"
            bulundu.

            Calma hizi StickS3'te YAZILIMDA yapiliyor (yeniden
            ornekleme, pati_ses.cpp). Onceki kartta I2S saat ayariydi;
            burada saat mikrofonla paylasildigi icin degistirilemiyor.

    config PATI_YARIM_DUPLEKS
        bool "Yanki korumasi ACIK olarak baslasin (panelden degistirilebilir)"
        default y
        help
            YANKI SORUNU: hoparlorle mikrofon yan yana duruyor. Robot
            konusurken mikrofon kendi sesini duyuyor ve sunucunun VAD'i
            bunu "cocuk konusuyor" sanip robotun sozunu kesiyor. Robot
            kendi sozunu keser. iPhone'da CANLI GORULDU
            (asama1/NOTLAR.md §3e).

            Koruma acikken robot konusurken mikrofon verisi
            GONDERILMIYOR (yarim dupleks).

            BEDELI: sozunu kesme CALISMAZ. Cocuk robotun uzerine
            konustugunda robot duymaz.

            ⚠️ BU SADECE BASLANGIC DEGERI. Asil ayar panelde:
            "Pati'nin sozu kesilebilsin". NVS'te kayit varsa o gecerli;
            burasi yalnizca kutudan yeni cikmis robotun hali.
            Varsayilan `y` cunku PC tarafinda da soz kesme KAPALI
            (PLAN §4.4) ve iki tarafin ayni davranmasi sart.

            ⚠️ Bu bir COZUM DEGIL, bir KOLDUR. Gercek cozum govde
            tasariminda: hoparloru mikrofondan uzaga ve ters yone koymak
            (PLAN §4.6).

            Onerilen sira:
              1. Koruma KAPALI + kulaklik  -> temiz gecikme VE sozunu
                 kesme olcumu
              2. Koruma KAPALI + hoparlor  -> yanki gercekten sorun mu
              3. Koruma ACIK + hoparlor    -> sorunsa gecici care

    config PATI_VAD_SESSIZLIK_MS
        int "Sunucunun 'sustu' karari (ms)"
        default 500
        help
            Gemini'nin cocugun sustuguna karar verme suresi. PLAN'da
            "gecikmenin EN BUYUK PARCASI, ayarlanabilir" diye isaretli.
            Dusurmek gecikmeyi azaltir ama cocugun sozunu kesme riskini
            artirir. 0 = sunucu varsayilani.

    # -----------------------------------------------------------------------
    # 🔴 PATI_EKRAN_VAR KALDIRILDI — geri EKLEMEYIN.
    # -----------------------------------------------------------------------
    #
    # Onceki kartta ekran disaridan lehimlenen bir moduldu ve varligi
    # KODDAN ANLASILAMIYORDU: ST7789'un SPI yolu tek yonlu kuruluyor,
    # panel hic bagli olmasa bile esp_lcd hatasiz aciliyor. Olu bir
    # modulle saatlerce boyle gorundu. O yuzden "ekran takili mi" diye
    # SORULMASI gerekiyordu — kod tahmin edemiyordu.
    #
    # StickS3'te ekran govdenin icinde ve sokulemiyor. Cevabi asla
    # degismeyecek bir soruyu ayar olarak birakmak, bir gun yanlis
    # cevaplanmasini beklemektir: birisi n yapar, Pati yuzsuz acilir ve
    # sebebi bir yapilandirma dosyasinda aranir.

endmenu
